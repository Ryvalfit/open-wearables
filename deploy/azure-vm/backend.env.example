ENVIRONMENT=production
API_PORT=8000
API_BASE_URL=https://wearables.herofitness.es
FRONTEND_URL=http://localhost:3400
CORS_ORIGINS=["http://localhost:3400"]
CORS_ALLOW_ALL=false
DB_HOST=psql-rvf-prod-neu.postgres.database.azure.com
DB_PORT=5432
DB_NAME=open_wearables
DB_USER=hero_open_wearables
# Use 64 hex characters: upstream interpolates the password into a URI.
DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
PGCONNECT_TIMEOUT=10
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
REDIS_SSL=false
SECRET_KEY=REPLACE_WITH_128_HEX_CHARACTERS
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
SENTRY_ENABLED=false
ACCESS_LOG_LEVEL=errors
LOG_ERROR_RESPONSE_BODY=false
RAW_PAYLOAD_STORAGE=disabled
SDK_PAYLOAD_S3_OFFLOAD=false
STORE_FIT_FILES=false
INGEST_WORKOUT_SAMPLES=false
DEFAULT_DATA_GRANULARITY=raw
SYNC_RUN_TRACKING_ENABLED=true
PERSIST_LIVE_SYNC_RUNS=false
OUTGOING_WEBHOOKS_ENABLED=true
SVIX_SERVER_URL=http://svix:8071
SVIX_JWT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# Add only provider credentials actually approved for this release.
# Invitations require a configured Resend account and verified sender.
